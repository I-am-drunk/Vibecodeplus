{
  "name": "vibecode-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"bun run server/index.ts\" \"vite --config vite.config.ts\"",
    "build": "vite build && bun build server/index.ts --outdir dist/server --target bun",
    "start": "NODE_ENV=production bun run dist/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
